# 本地示例配置，非真实凭据（文件头注明）
# 既有 7 项
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
APP_ENV=local

# A 组（13 项）
DATABASE_URL=postgres://alert:CHANGE_ME@127.0.0.1:5432/alert?sslmode=disable
MIGRATE_ON_START=false
TASK_LEASE=30s
TASK_MAX_ATTEMPTS=3
OWNERSHIP_TTL=60s
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_CLAIM_LEASE=30s
OUTBOX_BATCH=16
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=alertflow.system.events.v1
PROBE_WORKERS=8
PROBE_QUEUE_CAPACITY=1024
AGENT_GRPC_TARGET=127.0.0.1:50051

# B 组（13 项）
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_CONNECT_TIMEOUT=5s
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTHCHECK_PERIOD=30s
GRPC_ADDR=:9090
AGENT_GRPC_TIMEOUT=5s
OUTBOX_POLL_INTERVAL=500ms
TASK_RETRY_DELAY=30s
TASK_DEADLINE=10m
PROBE_SHUTDOWN_TIMEOUT=5s
READYZ_TIMEOUT=2s