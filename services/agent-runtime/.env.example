# Alert agent-runtime configuration template.
# Placeholder values ONLY -- copy to a local .env and fill real values.
# Never commit real credentials, DSNs or tokens (CR-BOOT-03).
# Startup validation rejects placeholders for required keys (fail-fast, 6.9.2.1).

# --- shared ---
LOG_LEVEL=INFO
DATABASE_URL_COGNITIVE=postgresql://cognitive_user:changeme@localhost:5432/alert
# POOL_MIN_SIZE=1
# POOL_MAX_SIZE=10
# SHUTDOWN_TIMEOUT_SECONDS=20
# OBSERVE_QUEUE_SIZE=1024
# OBSERVE_BATCH_SIZE=100
# OBSERVE_FLUSH_INTERVAL_SECONDS=5.0

# --- gateway ---
AGENT_GRPC_TARGET=127.0.0.1:50051
AGENT_GRPC_LISTEN=0.0.0.0:50052
HTTP_LISTEN=0.0.0.0:8080
INTERNAL_TOKEN=changeme
# GATEWAY_RPC_TIMEOUT_MS=3000
# GATEWAY_RPC_MAX_RETRIES=3
# HEARTBEAT_INTERVAL_SECONDS=10.0
# HEARTBEAT_FAILURE_THRESHOLD=3
# TASK_LEASE_SECONDS=30.0
# OWNERSHIP_TTL_SECONDS=60.0
# RECOVERY_SCAN_INTERVAL_SECONDS=30
# WORKER_CONCURRENCY=4
# QUEUE_CAPACITY=128

# --- diagnosis (agent budgets, D10) ---
# DIAGNOSIS_MAX_TOOL_ROUNDS=6
# DIAGNOSIS_MAX_LLM_CALLS=8
# DIAGNOSIS_DEADLINE_RATIO=0.8
# DIAGNOSIS_MAX_NO_PROGRESS=2
# FAULT_SEARCH_TOP_K=5
# PROMPT_TIMELINE_BUDGET_CHARS=4000
# PROMPT_SEARCH_BUDGET_CHARS=4000
# PROMPT_KNOWLEDGE_BUDGET_CHARS=4000
# PROMPT_MCP_BUDGET_CHARS=4000
# PROMPT_SUMMARY_ITEMS=10
# PROMPT_ACTIONS_ITEMS=10
# PROMPT_LAST_ERROR_MAX_CHARS=500
MCP_ENDPOINT=http://mcp-server:9000
MCP_TOKEN=changeme
# MCP_CALL_TIMEOUT_SECONDS=30.0
# MCP_MAX_RETRIES=2
# MCP_TOOL_CATALOG_TTL_SECONDS=300.0
KNOWLEDGE_A2A_ENDPOINT=http://knowledge-agent:9001
# KNOWLEDGE_TIMEOUT_MS=20000
# KNOWLEDGE_MAX_RETRIES=2
# KNOWLEDGE_TOP_K=8
# KNOWLEDGE_REQUIRE_CITATIONS=true

# --- retrieval (RAG budgets, D10) ---
# RETRIEVAL_MAX_HOPS=3
# RETRIEVAL_MAX_LLM_CALLS=12
# RETRIEVAL_DEADLINE_SECONDS=90.0
# RETRIEVAL_MAX_ZERO_NEW_HITS=1
# RRF_K=60
# VECTOR_TOP_K=8
# FUSION_TOP_K=10
# RERANK_TOP_K=5
# GRADE_THRESHOLD=6
# SEARCH_TOP_K_MAX=20
# PARENT_EXPAND_MAX_CHUNKS=8
# PARENT_EXPAND_MAX_TOKENS=900
# REFUSAL_MESSAGE=依据现有资料无法回答，请换问法或补充资料。

# --- ingestion ---
INGEST_FILE_ROOT=./data/ingest
# CALLBACK_HOST_ALLOWLIST=localhost,127.0.0.1
# CHUNK_SIZE_TOKENS=500
# CHUNK_OVERLAP_TOKENS=50
# INGEST_CALLBACK_TIMEOUT_SECONDS=10.0
# INGEST_CALLBACK_MAX_RETRIES=3
# INGEST_POLL_INTERVAL_SECONDS=5.0

# --- llm / embedding / rerank (OpenAI-compatible, D7) ---
LLM_API_BASE=https://llm.example.internal/v1
LLM_API_KEY=changeme
LLM_MODEL=changeme-model
# FAST_TEMPERATURE=0.1
# LLM_CONNECT_TIMEOUT_SECONDS=10.0
# LLM_READ_TIMEOUT_SECONDS=60.0
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=1.0
# LLM_JSON_REASK_ATTEMPTS=1
ENABLE_EMBEDDING=true
EMBEDDING_API_BASE=https://llm.example.internal/v1
EMBEDDING_API_KEY=changeme
EMBEDDING_MODEL=changeme-embedding
EMBED_DIM=1024
ENABLE_RERANK=true
RERANK_API_BASE=https://llm.example.internal/v1
RERANK_API_KEY=changeme
RERANK_MODEL=changeme-rerank

# --- storage ---
ARTIFACT_STORAGE_ROOT=./data/artifacts